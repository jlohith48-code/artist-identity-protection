# Backend Environment Variables Example
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artist_protection
JWT_SECRET_KEY=change_this_to_a_secure_32_byte_random_string_in_production
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# External API Keys (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
